<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <GeneDef ParentName="SHG_ArchetypeBase">
        <defName>SHG_Archetypes_MonsterSlayer</defName>
        <label>monster slayer</label>
        <description>All across the land there are beasts and machines and unimaginable horrors that seek to wipe out all human life, and monster slayers seek to return the favor. Their supernatural precision allows them to take down many of these foes with ease, and their telepush and telepull abilities allow them to make sure those foes will be right where the slayer needs them to be.</description>
        <iconPath>Archetypes/Gene_MonsterSlayer</iconPath>
        <biostatMet>-4</biostatMet>
        <statFactors>
            <EBSG_OutgoingDamageFactor_Entity MayRequire="Ludeon.Rimworld.Anomaly">5</EBSG_OutgoingDamageFactor_Entity>
            <EBSG_OutgoingDamageFactor_Mechanoid>3</EBSG_OutgoingDamageFactor_Mechanoid>
            <EBSG_OutgoingDamageFactor_Animal>1.5</EBSG_OutgoingDamageFactor_Animal>
        </statFactors>
        <abilities>
            <li MayRequire="Ludeon.Rimworld.Anomaly">SHG_DetectMetalHorror</li>
            <li>SHG_Telepush</li>
            <li>SHG_Telepull</li>
        </abilities>
        <descriptionHyperlinks>
            <AbilityDef MayRequire="Ludeon.Rimworld.Anomaly">SHG_DetectMetalHorror</AbilityDef>
            <AbilityDef>SHG_Telepush</AbilityDef>
            <AbilityDef>SHG_Telepull</AbilityDef>
        </descriptionHyperlinks>
        <modExtensions>
            <li Class="EBSGFramework.EBSGExtension">
                <conflictingGenes>
                    <li MayRequire="Ludeon.Rimworld.Anomaly">SHG_DetectMetalHorror</li>
                    <li>SHG_Telepush</li>
                    <li>SHG_Telepull</li>
                </conflictingGenes>
            </li>
        </modExtensions>
    </GeneDef>

    <HediffDef ParentName="SHG_EverEvolvingBase">
        <defName>SHG_EverEvolving_Lethality</defName>
        <label>ever evolving (lethality)</label>
        <description>This pawn consumed or had something used on them that allows them to surpass the limits of their genetic code. This particular evolution makes them far more deadly than they normally would be.</description>
        <stages>
            <li>
                <statOffsets>
                    <EBSG_OutgoingDamageFactor>0.1</EBSG_OutgoingDamageFactor>
                </statOffsets>
                <multiplyStatChangesBySeverity>true</multiplyStatChangesBySeverity>
            </li>
        </stages>
    </HediffDef>
</Defs>
