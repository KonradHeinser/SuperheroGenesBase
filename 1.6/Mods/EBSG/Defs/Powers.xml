<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <GeneDef ParentName="SuperPowersSupportBase">
        <defName>SHG_TemporaryForcefield</defName>
        <label>temporary forcefield</label>
        <description>Carriers of this gene can create a forcefield around themselves that blocks up to 500 points of damage once per day.</description>
        <iconPath>Powers/Gene_Forcefield</iconPath>
        <biostatMet>-1</biostatMet>
        <abilities>
            <li>SHG_TemporaryForcefield</li>
        </abilities>
        <exclusionTags>
            <li>SHG_Forcefield</li>
        </exclusionTags>
        <descriptionHyperlinks>
            <AbilityDef>SHG_TemporaryForcefield</AbilityDef>
        </descriptionHyperlinks>
    </GeneDef>

    <AbilityDef ParentName="SHGSelfCastBase">
        <defName>SHG_TemporaryForcefield</defName>
        <label>forcefield</label>
        <description>Create a barrier around the pawn that blocks up to 500 points of damage. This barrier does not vanish after the day is up, but will be replaced if this ability is used again.</description>
        <iconPath>Powers/Gene_Forcefield</iconPath>
        <jobDef>CastAbilityOnThingWithoutWeapon</jobDef>
        <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
        <cooldownTicksRange>60000</cooldownTicksRange>
        <comps>
            <li Class="CompProperties_AbilityGiveHediff">
                <compClass>CompAbilityEffect_GiveHediff</compClass>
                <hediffDef>SHG_TemporaryForcefield</hediffDef>
                <replaceExisting>True</replaceExisting>
            </li>
        </comps>
    </AbilityDef>

    <HediffDef ParentName="SHG_HiddenHediffBase">
        <defName>SHG_TemporaryForcefield</defName>
        <label>forcefield</label>
        <description>A constant forcefield is being generated around this pawn to protect them from damage.</description>
        <comps>
            <li Class="EBSGFramework.HediffCompProperties_Shield">
                <maxEnergy>3</maxEnergy>
                <energyRechargeRate>0</energyRechargeRate>
                <blocksMeleeDamage>True</blocksMeleeDamage>
                <gizmoTip>A constant forcefield protects this pawn from most harm.</gizmoTip>
                <energyOnReset>1</energyOnReset>
                <energyPerDamageModifier>0.01</energyPerDamageModifier>
                <removeOnBreak>True</removeOnBreak>
            </li>
        </comps>
    </HediffDef>

    <GeneDef ParentName="SuperPowersSummoningBase">
        <defName>SHG_CopySelf</defName>
        <label>copy self</label>
        <description>Carriers of this gene can create a permanent copy of themselves once per quadrum.</description>
        <iconPath>Powers/Gene_Telepull</iconPath>
        <marketValueFactor>3</marketValueFactor>
        <displayOrderInCategory>-1</displayOrderInCategory>
        <biostatArc>1</biostatArc>
        <biostatMet>0</biostatMet>
        <abilities>
            <li>SHG_CopySelf</li>
        </abilities>
        <descriptionHyperlinks>
            <AbilityDef>SHG_CopySelf</AbilityDef>
        </descriptionHyperlinks>
    </GeneDef>

    <AbilityDef ParentName="SHGSelfCastBase">
        <defName>SHG_CopySelf</defName>
        <label>copy self</label>
        <description>Create a permanent copy of the caster, including any current health effects they may have. This copy will start without any of the equipment the caster, but will be able to also copy itself once it has been around for a quadrum.</description>
        <iconPath>Things/Mote/SpeechSymbols/Speech</iconPath>
        <sendMessageOnCooldownComplete>True</sendMessageOnCooldownComplete>
        <displayGizmoWhileUndrafted>True</displayGizmoWhileUndrafted>
        <disableGizmoWhileUndrafted>False</disableGizmoWhileUndrafted>
        <cooldownTicksRange>900000</cooldownTicksRange>
        <hostile>false</hostile>
        <comps>
            <li Class="EBSGFramework.CompProperties_AbilityDuplicatePawn" />
            <li Class="EBSGFramework.CompProperties_AbilityStartOnCooldown" />
        </comps>
    </AbilityDef>
</Defs>
